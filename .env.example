# Supabase Configuration (server-side secrets - never commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# LLM Providers (OpenRouter $0 Free + NVIDIA NIM)
OPENROUTER_API_KEY=sk-or-v1-...
NVIDIA_NIM_API_KEY=nvapi-...
DEFAULT_OPENROUTER_MODEL=nim/nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional Search & Crawl Providers
SERPER_API_KEY=
JINA_API_KEY=

# Locked Single-Admin Credentials (set via `wrangler secret put` in production)
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_DISPLAY_NAME=Hamdi Soudani

# Session & Automation Security
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-char-random-hex
# Optional static bearer token for automation/CI (bypasses human Turnstile check)
ADMIN_TOKEN=

# Cloudflare Turnstile (enforced on admin login + human admin endpoints)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Google Analytics 4 Measurement ID (also configurable in Admin -> Settings)
GA_MEASUREMENT_ID=

# Public Site Defaults
SITE_NAME=Pyvren
BASE_URL=https://pyvren.com
