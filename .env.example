# Supabase Configuration (server-side secrets - never commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# OpenRouter LLM Provider
OPENROUTER_API_KEY=sk-or-v1-...
DEFAULT_OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional Search & Crawl Providers
SERPER_API_KEY=
JINA_API_KEY=

# Security & Admin Auth
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-char-random-hex
# Optional bootstrap guard for creating the single admin user (if set, required on first setup)
ADMIN_BOOTSTRAP_SECRET=
# Optional static bearer token for automation/CI (leave blank to require session login only)
ADMIN_TOKEN=

# Public Site Defaults
SITE_NAME=Pyvren Research
BASE_URL=https://pyvren.com
