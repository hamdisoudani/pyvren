{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyvren",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "workflows": [
    {
      "name": "editorial-agent-workflow",
      "binding": "EDITORIAL_AGENT_WORKFLOW",
      "class_name": "EditorialAgentWorkflow"
    }
  ],
  "routes": [
    { "pattern": "pyvren.com", "custom_domain": true }
  ],
  "vars": {
    "SITE_NAME": "Pyvren",
    "BASE_URL": "https://pyvren.com",
    "DEFAULT_OPENROUTER_MODEL": "baidu/ernie-5.5-flash-preview:free",
    "ENVIRONMENT": "production"
  }
}
